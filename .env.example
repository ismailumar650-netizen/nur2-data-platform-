# Browser-safe Supabase project configuration only.
# Use the project's URL and publishable/anon key. Never put service-role,
# Supabase secret, VTUGate, or Paystack secret keys in this file.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
